# Optional OpenSky OAuth2 credentials (server only)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
PORT=3001
# Public CARTO tile key; Vite embeds this in the browser bundle.
VITE_CARTO_API_KEY=
# Optional browser-side request/marker counts (development only; never logs credentials).
VITE_AEROTRACE_DIAGNOSTICS=false
# Optional server-side upstream/normalization/cache counts (never logs credentials).
AEROTRACE_DIAGNOSTICS=0
